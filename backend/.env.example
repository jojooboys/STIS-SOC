# Salin sebagai backend/.env; jangan commit file .env yang sebenarnya.
FLASK_CONFIG=development
# Buat nilai unik dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GANTI_DENGAN_SECRET_ACAK
LOG_LEVEL=INFO
# Opsional; SQLite relatif disimpan di backend/instance/.
# DATABASE_URL=sqlite:///soc.db
